<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings
        xmlns="https://jakarta.ee/xml/ns/persistence/orm"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm
                            https://jakarta.ee/xml/ns/persistence/orm/orm_3_1.xsd"
        version="3.1">

    <!--
        Kredi türü varlığı.
        customerType enum alanı STRING olarak saklanır (okunabilirlik ve şema esnekliği).
        parentCreditType: öz-referanslı ManyToOne ilişkisi — sahip (owning) taraf, PARENT_CREDIT_TYPE_ID kolonuna yazar.
        subCreditTypes: ters OneToMany — aynı PARENT_CREDIT_TYPE_ID kolonu üzerinden OKUR;
                        insertable/updatable=false ile yazma yetkisi parentCreditType'a bırakılır.
                        mapped-by yerine bu yaklaşım kullanılır: öz-referanslı XML mapping'de
                        IntelliJ mapped-by sembol çözümlemesi yapamaz; davranış tamamen eşdeğerdir.
    -->
    <entity class="tr.com.huseyinaydin.domain.credittype.CreditType" access="FIELD">

        <table name="CREDIT_TYPES"/>

        <attributes>
            <basic name="name">
                <column name="NAME" nullable="false" length="100"/>
            </basic>
            <basic name="description">
                <column name="DESCRIPTION" length="500" nullable="true"/>
            </basic>
            <basic name="customerType">
                <column name="CUSTOMER_TYPE" nullable="false" length="20"/>
                <enumerated>STRING</enumerated>
            </basic>
            <basic name="minimumTermMonths">
                <column name="MIN_TERM" nullable="false"/>
            </basic>
            <basic name="maximumTermMonths">
                <column name="MAX_TERM" nullable="false"/>
            </basic>
            <basic name="annualInterestRate">
                <column name="BASE_INTEREST_RATE" nullable="false" precision="5" scale="2"/>
            </basic>
            <many-to-one name="parentCreditType"
                         target-entity="tr.com.huseyinaydin.domain.credittype.CreditType"
                         fetch="LAZY">
                <join-column name="PARENT_CREDIT_TYPE_ID" nullable="true"/>
            </many-to-one>
            <one-to-many name="subCreditTypes"
                         target-entity="tr.com.huseyinaydin.domain.credittype.CreditType"
                         fetch="LAZY">
                <join-column name="PARENT_CREDIT_TYPE_ID"
                             nullable="true"
                             insertable="false"
                             updatable="false"/>
            </one-to-many>
            <!--
                minimumAmount / maximumAmount: Money value object embedded olarak eşlenir.
                Money.amount → MIN_AMOUNT/MAX_AMOUNT, Money.currency → MIN_CURRENCY/MAX_CURRENCY.
                Embeddable'ın kendi kolon adları attribute-override ile geçersiz kılınır.
                NOT: JPA orm_3_1.xsd 'attributes' sıralaması gereği <embedded> öğeleri
                basic/many-to-one/one-to-many öğelerinden SONRA gelmek zorundadır.
            -->
            <embedded name="minimumAmount">
                <attribute-override name="amount">
                    <column name="MIN_AMOUNT" nullable="false" precision="18" scale="2"/>
                </attribute-override>
                <attribute-override name="currency">
                    <column name="MIN_CURRENCY" nullable="false" length="3"/>
                </attribute-override>
            </embedded>
            <embedded name="maximumAmount">
                <attribute-override name="amount">
                    <column name="MAX_AMOUNT" nullable="false" precision="18" scale="2"/>
                </attribute-override>
                <attribute-override name="currency">
                    <column name="MAX_CURRENCY" nullable="false" length="3"/>
                </attribute-override>
            </embedded>
        </attributes>

    </entity>

    <!--
        Money value object'inin embeddable eşlemesi. Kolon adları burada nötr bırakılır
        (AMOUNT / CURRENCY) ve her kullanım yerinde <attribute-override> ile gerçek kolonlara
        bağlanır. Bu embeddable yalnızca CreditType tarafından kullanıldığından tanımı bu
        dosyada tutulur; ayrı bir mapping dosyası ve PersistenceConfig değişikliği gerekmez.
    -->
    <embeddable class="tr.com.huseyinaydin.domain.valueobjects.Money" access="FIELD">
        <attributes>
            <basic name="amount">
                <column name="AMOUNT" nullable="false" precision="18" scale="2"/>
            </basic>
            <basic name="currency">
                <column name="CURRENCY" nullable="false" length="3"/>
            </basic>
        </attributes>
    </embeddable>

</entity-mappings>
