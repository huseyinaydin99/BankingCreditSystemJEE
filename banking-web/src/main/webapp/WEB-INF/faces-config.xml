<?xml version="1.0" encoding="UTF-8"?>
<faces-config xmlns="https://jakarta.ee/xml/ns/jakartaee"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
              https://jakarta.ee/xml/ns/jakartaee/web-facesconfig_4_0.xsd"
              version="4.0">

    <application>
        <!--
            Spring bean'lerini JSF EL ortamına açar.
            #{mediator}, #{commandBus} gibi Spring bean'leri Facelets sayfalarında
            ve @ManagedProperty aracılığıyla kullanılabilir hale gelir.
        -->
        <el-resolver>org.springframework.web.jsf.el.SpringBeanFacesELResolver</el-resolver>

        <locale-config>
            <default-locale>tr</default-locale>
            <supported-locale>en</supported-locale>
        </locale-config>
    </application>

    <!-- Navigation rules -->
    <navigation-rule>
        <from-view-id>/customers/list.xhtml</from-view-id>
        <navigation-case>
            <from-outcome>success</from-outcome>
            <to-view-id>/customers/list.xhtml</to-view-id>
            <redirect/>
        </navigation-case>
        <navigation-case>
            <from-outcome>error</from-outcome>
            <to-view-id>/customers/list.xhtml</to-view-id>
        </navigation-case>
    </navigation-rule>

</faces-config>
